*{box-sizing:border-box}
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#172033;background:#f5f7fb}
body{margin:0;background:#f5f7fb;color:#172033}
button,input,select,textarea{font:inherit}
button{cursor:pointer;border:0;border-radius:9px;padding:10px 15px;background:#172033;color:#fff}
button:hover{opacity:.92}button:disabled{opacity:.55;cursor:not-allowed}
.app{display:flex;min-height:100vh}
aside{width:260px;background:#101827;color:#fff;padding:26px 16px;position:fixed;inset:0 auto 0 0;display:flex;flex-direction:column;z-index:20}
.brand{display:flex;align-items:center;gap:11px;font-size:21px;font-weight:800;padding:0 10px 34px}
.brand-mark{width:36px;height:36px;border-radius:10px;background:#fff;color:#172033;display:grid;place-items:center;font-weight:900}
.nav-label{font-size:11px;letter-spacing:1.8px;color:#94a3b8;font-weight:800;padding:0 14px 10px}
nav{display:grid;gap:7px}
nav button{background:transparent;text-align:left;color:#cbd5e1;width:100%;display:flex;align-items:center;gap:12px;font-weight:650}
nav button.active{background:#34445d;color:#fff}
.nav-icon{width:20px;text-align:center}
.sidebar-user{margin-top:auto;border-top:1px solid #263246;padding:18px 9px;display:flex;gap:10px;align-items:center}
.avatar{width:36px;height:36px;border-radius:50%;background:#e2e8f0;color:#172033;display:grid;place-items:center;font-weight:800;flex:0 0 auto}
.sidebar-user strong,.sidebar-user small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sidebar-user strong{font-size:13px}.sidebar-user small{font-size:11px;color:#94a3b8;margin-top:3px}
.logout{width:100%;background:#34445d}
main{margin-left:260px;width:calc(100% - 260px);padding:34px;max-width:1600px}
header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px}
.eyebrow{font-size:11px;letter-spacing:1.8px;color:#91a0b8;font-weight:800;margin-bottom:6px}
header h1{margin:0 0 4px;font-size:36px;letter-spacing:-1px}header span{color:#64748b}
.sync-pill{background:#edf9f0;border:1px solid #bfe7c8;color:#24733b;border-radius:22px;padding:9px 14px;font-size:13px;font-weight:750}
.sync-pill i{display:inline-block;width:8px;height:8px;border-radius:50%;background:#2e8b57;margin-right:7px}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:30px}
.card,.panel,.info-panel{background:#fff;border:1px solid #e5e7eb;border-radius:15px;padding:20px;box-shadow:0 2px 10px #00000008}
.card span{color:#64748b;font-size:14px}.card strong{display:block;font-size:31px;margin-top:9px}.card small{display:block;color:#8793a8;margin-top:7px}
.analytics-heading{margin:0 0 16px}.analytics-heading h2{margin:0 0 4px;font-size:20px}.analytics-heading p{margin:0;color:#64748b;font-size:13px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.chart{height:300px;max-width:390px;margin:10px auto}.panel{margin-bottom:20px;overflow:auto}.panel h3{margin:0 0 16px}.panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.panel-head h3{margin:0}.panel-head span{color:#64748b;font-size:13px}
table{width:100%;border-collapse:collapse;min-width:700px}th,td{text-align:left;padding:13px 10px;border-bottom:1px solid #edf0f4}th{color:#64748b;font-size:12px}td small{display:block;color:#94a3b8;margin-top:4px}
.toolbar{display:flex;gap:10px;margin-bottom:18px}.toolbar input{flex:1}.toolbar select{width:170px}
input,select,textarea{border:1px solid #d8dee8;border-radius:9px;padding:10px;background:#fff;outline:none;width:100%}textarea{min-height:100px;resize:vertical}
.badge{display:inline-block;padding:5px 9px;border-radius:20px;background:#eef2ff;font-size:12px}.status-rejected{background:#fee2e2;color:#991b1b}.status-offer{background:#dcfce7;color:#166534}.status-interview{background:#e0f2fe;color:#075985}.status-withdrawn{background:#f1f5f9;color:#475569}.status-wishlist{background:#fef3c7;color:#92400e}
.small{padding:6px 9px;font-size:12px}.danger{background:#b91c1c}.secondary{background:#e2e8f0;color:#172033}.nowrap{white-space:nowrap}
.modal{position:fixed;inset:0;background:#0f172a99;display:flex;align-items:center;justify-content:center;padding:20px;z-index:50}.modal-card{background:#fff;border-radius:15px;padding:25px;width:min(720px,100%);max-height:90vh;overflow:auto}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.wide{grid-column:1/-1}.actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}
.inline-form{display:flex;gap:10px}.inline-form input{flex:1}
.error{background:#fee2e2;color:#991b1b;padding:10px;border-radius:8px}.page-alert{margin-bottom:16px}.empty{padding:28px;text-align:center;color:#64748b}.loading{padding:30px;color:#64748b}.loading-screen,.page-error{min-height:100vh;display:grid;place-items:center;background:#f5f7fb;color:#172033}.page-error{padding:30px;text-align:center}.info-panel{margin-bottom:20px}.info-panel p{color:#64748b;margin-bottom:0}
.auth-page{min-height:100vh;display:grid;place-items:center;background:#111827;padding:20px}.auth-card{background:#fff;padding:34px;border-radius:18px;width:min(420px,100%);display:grid;gap:13px}.auth-card h1{margin:0}.auth-card p{color:#64748b;margin-top:0}.auth-card button.link{background:transparent;color:#475569}.auth-card .brand-mark{margin-bottom:4px}
@media(max-width:1050px){aside{width:220px}main{margin-left:220px;width:calc(100% - 220px);padding:24px}.cards{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){aside{width:72px;padding:20px 9px}.brand{padding:0 9px 30px}.brand>span,.nav-label,.sidebar-user>div:not(.avatar),nav button>span:not(.nav-icon){display:none}.brand-mark{width:36px}nav button{justify-content:center;padding:10px}.logout{font-size:0}.logout:after{content:"↪";font-size:18px}main{margin-left:72px;width:calc(100% - 72px);padding:18px}header h1{font-size:28px}.sync-pill{display:none}.grid2{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.wide{grid-column:auto}.inline-form{flex-direction:column}.toolbar{flex-direction:column}.toolbar select{width:100%}}
@media(max-width:480px){.cards{grid-template-columns:1fr}.card strong{font-size:27px}header{margin-bottom:20px}}

.ai-hero{background:linear-gradient(135deg,#ffffff,#eef4ff);border:1px solid #dce5f3;border-radius:16px;padding:24px;margin-bottom:20px;display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.ai-kicker{font-size:11px;letter-spacing:1.8px;font-weight:800;color:#64748b}.ai-hero h2{margin:5px 0 6px;font-size:26px}.ai-hero p{margin:0;color:#64748b;max-width:720px}.ai-badge{padding:8px 12px;border-radius:20px;background:#172033;color:#fff;font-size:11px;font-weight:800;letter-spacing:1px;white-space:nowrap}.muted{color:#64748b;font-size:13px;line-height:1.5;margin-top:-7px}.stack-form{display:grid;gap:11px}.divider{border-top:1px solid #edf0f4;margin:20px 0}.field-label{display:block;font-size:12px;font-weight:750;color:#64748b;margin-bottom:7px}.jd-box{min-height:220px}.analysis-mini{margin-top:15px;padding:13px;border-radius:10px;background:#f8fafc;border:1px solid #e7ebf1}.analysis-mini>strong,.analysis-mini>span{display:block}.analysis-mini>span{font-size:12px;color:#64748b;margin:4px 0 9px}.skill-chip{display:inline-block;padding:6px 9px;border-radius:20px;background:#eef2ff;margin:4px 5px 0 0;font-size:12px}.skill-chip.good{background:#dcfce7;color:#166534}.skill-chip.missing{background:#fee2e2;color:#991b1b}.match-panel{overflow:visible}.match-result{display:grid;gap:20px}.score-card{border:1px solid #dce5f3;border-radius:14px;padding:20px;background:#f8fafc;display:flex;align-items:baseline;gap:15px}.score-card span{color:#64748b}.score-card strong{font-size:42px}.score-card small{color:#64748b}.match-columns{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px}.match-columns h4{margin:0 0 9px}.match-columns ul{margin:0;padding-left:20px;color:#475569;line-height:1.7}.success-text{color:#166534;font-weight:700}@media(max-width:900px){.match-columns{grid-template-columns:1fr}.ai-hero{flex-direction:column}}
